{
  "openapi": "3.0.0",
  "info": {
    "title": "Clínica Dental Bethania — API",
    "description": "Sistema de gestión dental: agenda, pacientes, tratamientos, laboratorio, facturación, reportes, módulos y logs.\n\n**Autenticación:** POST /api/auth/login → cookies HttpOnly + setSession en cliente.\n\n**Base URL:** https://clinica-dental-bethania.vercel.app",
    "version": "1.0.0",
    "contact": { "email": "admin@clinicabethania.com" }
  },
  "servers": [
    { "url": "https://clinica-dental-bethania.vercel.app", "description": "Producción" },
    { "url": "http://localhost:5173", "description": "Desarrollo" }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": { "type": "apiKey", "in": "cookie", "name": "sb-access-token" }
    },
    "schemas": {
      "Patient": {
        "type": "object",
        "required": ["first_name", "last_name"],
        "properties": {
          "id": { "type": "integer" },
          "first_name": { "type": "string", "maxLength": 100 },
          "last_name": { "type": "string", "maxLength": 100 },
          "date_of_birth": { "type": "string", "nullable": true },
          "email": { "type": "string", "nullable": true },
          "phone": { "type": "string", "nullable": true },
          "address": { "type": "string", "nullable": true },
          "medical_alerts": { "type": "string", "nullable": true },
          "notes": { "type": "string", "nullable": true },
          "referral_source": { "type": "string", "nullable": true }
        }
      },
      "Appointment": {
        "type": "object",
        "required": ["operatory_id", "start_time", "end_time"],
        "properties": {
          "id": { "type": "integer" },
          "patient_id": { "type": "integer", "nullable": true },
          "practitioner_id": { "type": "integer", "nullable": true },
          "operatory_id": { "type": "integer" },
          "treatment_type_id": { "type": "integer", "nullable": true },
          "start_time": { "type": "string", "example": "2026-09-23T09:00:00" },
          "end_time": { "type": "string", "example": "2026-09-23T09:30:00" },
          "status": { "type": "string", "enum": ["scheduled", "confirmed", "completed", "cancelled", "no_show", "in_chair"], "default": "scheduled" },
          "kind": { "type": "string", "enum": ["patient", "block"], "default": "patient" },
          "title": { "type": "string", "nullable": true },
          "notes": { "type": "string", "nullable": true }
        }
      },
      "Practitioner": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "role": { "type": "string", "enum": ["dentist", "hygienist", "assistant", "receptionist"], "default": "dentist" },
          "color": { "type": "string", "default": "teal" },
          "email": { "type": "string", "nullable": true },
          "phone": { "type": "string", "nullable": true }
        }
      },
      "TreatmentType": {
        "type": "object",
        "required": ["code", "name"],
        "properties": {
          "id": { "type": "integer" },
          "code": { "type": "string", "maxLength": 20 },
          "name": { "type": "string" },
          "duration_minutes": { "type": "integer", "minimum": 1, "maximum": 600, "default": 30 },
          "default_fee": { "type": "number", "minimum": 0, "default": 0 },
          "color": { "type": "string", "default": "sky" }
        }
      },
      "Operatory": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "color": { "type": "string" },
          "sort_order": { "type": "integer" }
        }
      },
      "Invoice": {
        "type": "object",
        "required": ["patient_id"],
        "properties": {
          "id": { "type": "integer" },
          "patient_id": { "type": "integer" },
          "appointment_id": { "type": "integer", "nullable": true },
          "status": { "type": "string", "enum": ["open", "paid", "void", "partial"], "default": "open" },
          "total": { "type": "number", "minimum": 0, "default": 0 },
          "amount_paid": { "type": "number", "minimum": 0, "default": 0 },
          "notes": { "type": "string", "nullable": true }
        }
      },
      "LabCase": {
        "type": "object",
        "required": ["patient_id", "lab_name", "case_type"],
        "properties": {
          "id": { "type": "integer" },
          "patient_id": { "type": "integer" },
          "practitioner_id": { "type": "integer", "nullable": true },
          "treatment_type_id": { "type": "integer", "nullable": true },
          "lab_name": { "type": "string" },
          "case_type": { "type": "string" },
          "tooth": { "type": "string", "nullable": true },
          "shade": { "type": "string", "nullable": true },
          "fee": { "type": "number", "minimum": 0, "default": 0 },
          "status": { "type": "string", "enum": ["sent", "received", "seated", "cancelled"], "default": "sent" },
          "due_at": { "type": "string", "nullable": true },
          "notes": { "type": "string", "nullable": true }
        }
      },
      "ClinicalNote": {
        "type": "object",
        "required": ["patient_id", "body"],
        "properties": {
          "id": { "type": "integer" },
          "patient_id": { "type": "integer" },
          "practitioner_id": { "type": "integer", "nullable": true },
          "note_date": { "type": "string" },
          "body": { "type": "string" }
        }
      },
      "PlanItem": {
        "type": "object",
        "required": ["patient_id"],
        "properties": {
          "id": { "type": "integer" },
          "patient_id": { "type": "integer" },
          "treatment_type_id": { "type": "integer", "nullable": true },
          "tooth": { "type": "string", "nullable": true },
          "surface": { "type": "string", "nullable": true },
          "fee": { "type": "number", "minimum": 0, "default": 0 },
          "status": { "type": "string", "enum": ["planned", "approved", "completed", "cancelled"], "default": "planned" },
          "notes": { "type": "string", "nullable": true }
        }
      },
      "InsurancePlan": {
        "type": "object",
        "required": ["patient_id", "carrier"],
        "properties": {
          "id": { "type": "integer" },
          "patient_id": { "type": "integer" },
          "rank": { "type": "string", "enum": ["primary", "secondary", "tertiary"], "default": "primary" },
          "carrier": { "type": "string" },
          "member_id": { "type": "string", "nullable": true },
          "copay": { "type": "number", "default": 0 },
          "max_annual": { "type": "number", "default": 0 }
        }
      },
      "Module": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "key": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "enabled": { "type": "boolean" }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string" },
          "role": { "type": "string", "enum": ["superadmin", "admin", "dentist", "hygienist", "assistant", "receptionist", "user"] },
          "full_name": { "type": "string", "nullable": true },
          "active": { "type": "boolean" }
        }
      },
      "SystemLog": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "level": { "type": "string", "enum": ["info", "warning", "error", "critical"] },
          "category": { "type": "string" },
          "message": { "type": "string" },
          "user_email": { "type": "string", "nullable": true }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" },
          "turnstileToken": { "type": "string", "description": "Token de Cloudflare Turnstile (antibot)" }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" },
          "full_name": { "type": "string" },
          "role": { "type": "string", "enum": ["admin", "dentist", "hygienist", "assistant", "receptionist", "user"] }
        }
      }
    }
  },
  "tags": [
    { "name": "Auth", "description": "Autenticación y sesión" },
    { "name": "Pacientes", "description": "Expedientes clínicos" },
    { "name": "Citas", "description": "Agenda y programación" },
    { "name": "Practicantes", "description": "Dentistas y personal" },
    { "name": "Tipos de tratamiento", "description": "Catálogo de tratamientos" },
    { "name": "Consultorios", "description": "Sillas operativas" },
    { "name": "Plan de tratamiento", "description": "Ítems del plan por paciente" },
    { "name": "Notas clínicas", "description": "Notas del expediente" },
    { "name": "Condiciones dentales", "description": "Carta dental" },
    { "name": "Facturación", "description": "Facturas e insurance" },
    { "name": "Laboratorio", "description": "Casos de laboratorio" },
    { "name": "Lista de espera", "description": "Pacientes en espera" },
    { "name": "Citas por hacer", "description": "Recordatorios de citas" },
    { "name": "Reportes", "description": "Estadísticas del sistema" },
    { "name": "Configuración", "description": "Settings del sistema" },
    { "name": "Administración", "description": "Módulos, usuarios y logs (superadmin)" }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Iniciar sesión",
        "description": "Autentica al usuario, setea cookies HttpOnly y devuelve el access_token para setSession en el cliente.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
        "responses": {
          "200": { "description": "Login exitoso", "content": { "application/json": { "schema": { "type": "object", "properties": { "user": { "$ref": "#/components/schemas/Profile" }, "accessToken": { "type": "string" }, "refreshToken": { "type": "string" } } } } } },
          "401": { "description": "Credenciales inválidas" },
          "403": { "description": "Verificación antibot fallida" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Cerrar sesión",
        "description": "Elimina las cookies de sesión.",
        "responses": { "200": { "description": "Sesión cerrada" } }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Usuario actual",
        "description": "Devuelve el usuario autenticado desde las cookies HttpOnly.",
        "responses": { "200": { "description": "Usuario actual", "content": { "application/json": { "schema": { "type": "object", "properties": { "user": { "$ref": "#/components/schemas/Profile" } } } } } } }
      }
    },
    "/api/auth/create-user": {
      "post": {
        "tags": ["Auth"],
        "summary": "Crear usuario (superadmin)",
        "description": "Crea un nuevo usuario en Supabase Auth, su profile y le asigna todos los módulos habilitados. Solo superadmin.",
        "security": [{ "cookieAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateUserRequest" } } } },
        "responses": { "200": { "description": "Usuario creado" }, "403": { "description": "No autorizado" } }
      }
    },
    "/api/patients": {
      "get": {
        "tags": ["Pacientes"],
        "summary": "Listar pacientes",
        "parameters": [{ "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Buscar por nombre, email o teléfono" }],
        "responses": { "200": { "description": "Lista de pacientes" } }
      },
      "post": {
        "tags": ["Pacientes"],
        "summary": "Crear paciente",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Patient" } } } },
        "responses": { "200": { "description": "Paciente creado" } }
      }
    },
    "/api/patients/{id}": {
      "get": { "tags": ["Pacientes"], "summary": "Obtener paciente", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Paciente" } } },
      "put": { "tags": ["Pacientes"], "summary": "Actualizar paciente", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Patient" } } } }, "responses": { "200": { "description": "Paciente actualizado" } } },
      "delete": { "tags": ["Pacientes"], "summary": "Eliminar paciente", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Eliminado" } } }
    },
    "/api/patients/{id}/treatment-plan": { "get": { "tags": ["Plan de tratamiento"], "summary": "Plan de tratamiento del paciente", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Ítems del plan" } } } },
    "/api/patients/{id}/notes": { "get": { "tags": ["Notas clínicas"], "summary": "Notas clínicas del paciente", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Notas" } } } },
    "/api/patients/{id}/tooth-chart": { "get": { "tags": ["Condiciones dentales"], "summary": "Carta dental del paciente", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Condiciones" } } } },
    "/api/patients/{id}/invoices": { "get": { "tags": ["Facturación"], "summary": "Facturas del paciente", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Facturas" } } } },
    "/api/patients/{id}/insurance": { "get": { "tags": ["Facturación"], "summary": "Seguros del paciente", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Planes de seguro" } } } },
    "/api/appointments": {
      "get": { "tags": ["Citas"], "summary": "Listar citas", "parameters": [{ "name": "date", "in": "query", "schema": { "type": "string" } }, { "name": "patient_id", "in": "query", "schema": { "type": "integer" } }], "responses": { "200": { "description": "Citas" } } },
      "post": { "tags": ["Citas"], "summary": "Crear cita", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Appointment" } } } }, "responses": { "200": { "description": "Cita creada" } } }
    },
    "/api/appointments/{id}": {
      "put": { "tags": ["Citas"], "summary": "Actualizar cita", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Appointment" } } } }, "responses": { "200": { "description": "Cita actualizada" } } },
      "delete": { "tags": ["Citas"], "summary": "Eliminar cita", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Eliminada" } } }
    },
    "/api/practitioners": {
      "get": { "tags": ["Practicantes"], "summary": "Listar practicantes", "responses": { "200": { "description": "Practicantes" } } },
      "post": { "tags": ["Practicantes"], "summary": "Crear practicante", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Practitioner" } } } }, "responses": { "200": { "description": "Practicante creado" } } }
    },
    "/api/practitioners/{id}": {
      "put": { "tags": ["Practicantes"], "summary": "Actualizar practicante", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Actualizado" } } },
      "delete": { "tags": ["Practicantes"], "summary": "Eliminar practicante", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Eliminado" } } }
    },
    "/api/treatment-types": {
      "get": { "tags": ["Tipos de tratamiento"], "summary": "Listar tipos", "responses": { "200": { "description": "Tipos" } } },
      "post": { "tags": ["Tipos de tratamiento"], "summary": "Crear tipo", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TreatmentType" } } } }, "responses": { "200": { "description": "Tipo creado" } } }
    },
    "/api/treatment-types/{id}": {
      "put": { "tags": ["Tipos de tratamiento"], "summary": "Actualizar tipo", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Actualizado" } } },
      "delete": { "tags": ["Tipos de tratamiento"], "summary": "Eliminar tipo", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Eliminado" } } }
    },
    "/api/operatories": {
      "get": { "tags": ["Consultorios"], "summary": "Listar consultorios", "responses": { "200": { "description": "Consultorios" } } },
      "post": { "tags": ["Consultorios"], "summary": "Crear consultorio", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Operatory" } } } }, "responses": { "200": { "description": "Consultorio creado" } } }
    },
    "/api/operatories/{id}": {
      "put": { "tags": ["Consultorios"], "summary": "Actualizar", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Actualizado" } } },
      "delete": { "tags": ["Consultorios"], "summary": "Eliminar", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Eliminado" } } }
    },
    "/api/treatment-plan-items": {
      "post": { "tags": ["Plan de tratamiento"], "summary": "Crear ítem del plan", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlanItem" } } } }, "responses": { "200": { "description": "Ítem creado" } } }
    },
    "/api/treatment-plan-items/{id}": {
      "put": { "tags": ["Plan de tratamiento"], "summary": "Actualizar ítem", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Actualizado" } } },
      "delete": { "tags": ["Plan de tratamiento"], "summary": "Eliminar ítem", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Eliminado" } } }
    },
    "/api/clinical-notes": {
      "post": { "tags": ["Notas clínicas"], "summary": "Crear nota", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClinicalNote" } } } }, "responses": { "200": { "description": "Nota creada" } } }
    },
    "/api/clinical-notes/{id}": {
      "delete": { "tags": ["Notas clínicas"], "summary": "Eliminar nota", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Eliminada" } } }
    },
    "/api/tooth-conditions": {
      "post": { "tags": ["Condiciones dentales"], "summary": "Crear condición dental", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["patient_id", "tooth", "condition"], "properties": { "patient_id": { "type": "integer" }, "tooth": { "type": "string" }, "surface": { "type": "string", "nullable": true }, "condition": { "type": "string" } } } } } }, "responses": { "200": { "description": "Condición creada" } } }
    },
    "/api/tooth-conditions/{id}": {
      "delete": { "tags": ["Condiciones dentales"], "summary": "Eliminar condición", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Eliminada" } } }
    },
    "/api/invoices": {
      "post": { "tags": ["Facturación"], "summary": "Crear factura", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Invoice" } } } }, "responses": { "200": { "description": "Factura creada" } } }
    },
    "/api/invoices/{id}": {
      "put": { "tags": ["Facturación"], "summary": "Actualizar factura", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Actualizada" } } },
      "delete": { "tags": ["Facturación"], "summary": "Eliminar factura", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Eliminada" } } }
    },
    "/api/insurance-plans": {
      "post": { "tags": ["Facturación"], "summary": "Crear seguro", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InsurancePlan" } } } }, "responses": { "200": { "description": "Seguro creado" } } }
    },
    "/api/insurance-plans/{id}": {
      "put": { "tags": ["Facturación"], "summary": "Actualizar seguro", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Actualizado" } } },
      "delete": { "tags": ["Facturación"], "summary": "Eliminar seguro", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Eliminado" } } }
    },
    "/api/lab-cases": {
      "get": { "tags": ["Laboratorio"], "summary": "Listar casos", "parameters": [{ "name": "status", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "Casos" } } },
      "post": { "tags": ["Laboratorio"], "summary": "Crear caso", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LabCase" } } } }, "responses": { "200": { "description": "Caso creado" } } }
    },
    "/api/lab-cases/{id}": {
      "put": { "tags": ["Laboratorio"], "summary": "Actualizar caso", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Actualizado" } } },
      "delete": { "tags": ["Laboratorio"], "summary": "Eliminar caso", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Eliminado" } } }
    },
    "/api/waiting-list": {
