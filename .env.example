# Claves del proyecto Supabase + Turnstile (pedir al administrador)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_KEY=tu-anon-key
VITE_TURNSTILE_SITE_KEY=tu-site-key
TURNSTILE_SECRET_KEY=tu-secret-key
# Solo servidor (Vercel → Environment Variables, nunca al cliente):
# SUPABASE_SERVICE_KEY=tu-service-role-key
# CRON_SECRET=generado-con-openssl-rand-hex-16
# BACKUP_PASSPHRASE=solo-para-respaldos (no va en .env, va en GitHub Secrets)
